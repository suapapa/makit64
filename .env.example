# Copy to `.env` and fill in real values (`.env` is gitignored).
WIFI_SSID=your-ssid
WIFI_PASS=your-password

# Optional (default 5683)
# COAP_PORT=5683

# Panel orientation: clockwise degrees 0 | 90 | 180 | 270 (default 0).
# Use 90 if content appears rotated 90° counter-clockwise on the matrix.
DISPLAY_ROTATION=90
